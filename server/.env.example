# Copy this file to server/.env and fill in the values. Never commit server/.env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/trendcraft_ai
# Use a long random string (at least 24 characters).
JWT_SECRET=replace_with_a_long_random_secret
# Extra browser origin allowed to call the API (http://localhost:5173 and http://127.0.0.1:5173 always work in development).
CLIENT_URL=http://localhost:5173

# --- Google Gemini (optional; without a key the local styling engine is used) ---
# Get a key at https://aistudio.google.com/apikey and keep it ONLY in this file.
# Use AI_API_KEY or GEMINI_API_KEY (AI_API_KEY takes priority if both are set).
AI_API_KEY=
# Gemini's OpenAI-compatible endpoint.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# A currently supported Gemini model. Model names change over time; if you see an
# "AI model not found" message, pick a current Flash model from https://ai.google.dev/gemini-api/docs/models
AI_MODEL=gemini-3.8-flash
